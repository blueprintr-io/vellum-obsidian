{
  "name": "vellum-obsidian",
  "version": "1.0.0",
  "private": true,
  "description": "Vellum diagrams in Obsidian.",
  "license": "SEE LICENSE IN LICENSE",
  "author": "Josh Morris",
  "homepage": "https://github.com/blueprintr-io/vellum-obsidian",
  "repository": {
    "type": "git",
    "url": "https://github.com/blueprintr-io/vellum-obsidian"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "core": "node scripts/core.mjs",
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc -p tsconfig.json && tsc -p frame/tsconfig.json && tsc -p test/tsconfig.json",
    "test": "node --test --import tsx --import ./test/unit/register.mjs test/unit/*.test.ts",
    "test:frame": "playwright test -c test/frame/playwright.config.ts",
    "bump": "node scripts/version.mjs"
  },
  "dependencies": {
    "@dagrejs/dagre": "3.0.0",
    "@fontsource/architects-daughter": "5.2.7",
    "@fontsource/caveat": "5.2.8",
    "@fontsource/fira-code": "5.2.7",
    "@fontsource/ibm-plex-mono": "5.2.7",
    "@fontsource/inter": "5.2.8",
    "@fontsource/jetbrains-mono": "5.2.8",
    "@fontsource/lora": "5.2.8",
    "@fontsource/outfit": "5.2.8",
    "@fontsource/patrick-hand": "5.2.8",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-popover": "1.1.15",
    "@radix-ui/react-tooltip": "1.2.8",
    "dompurify": "3.4.16",
    "fflate": "0.8.3",
    "gifenc": "1.0.3",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "yaml": "2.8.3",
    "zod": "4.3.6",
    "zustand": "5.0.12"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "22.15.30",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.5.0",
    "esbuild": "0.25.12",
    "jsdom": "29.0.2",
    "obsidian": "1.14.4",
    "postcss": "8.5.28",
    "tailwindcss": "3.4.19",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "6.4.3"
  }
}
